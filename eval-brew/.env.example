# Local development overrides for docker-compose.
# Copy this file to .env (gitignored) and adjust for your environment.
# NEVER commit .env — it may contain secrets.

# Bypass Azure AD authentication when running locally (e.g. localhost can't
# be registered as an SSO redirect URI, or during offline deployment testing).
# Default in docker-compose.yml is true (auth enabled); override here for dev.
HARNESS_AUTH_ENABLED=false
