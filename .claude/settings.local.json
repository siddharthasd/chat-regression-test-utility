{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "Bash(where.exe python *)",
      "Bash(where.exe uv *)",
      "Bash(where.exe git *)",
      "Bash(where.exe pipx *)",
      "WebFetch(domain:api.github.com)",
      "Bash(uv tool *)",
      "Bash(specify --version)",
      "Bash(specify --help)",
      "Bash(Select-Object -First 25)",
      "Bash(specify init *)",
      "Bash(PYTHONIOENCODING=utf-8 PYTHONUTF8=1 specify init *)"
    ]
  }
}
