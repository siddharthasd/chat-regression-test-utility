# Template for local development. Copy to .env and fill in your values.
# NEVER commit .env — it may contain secrets.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection details. The URL is assembled at runtime.
# For AKS deployments with managed identity, set these three vars — no password needed.
HARNESS_PG_HOST=localhost
HARNESS_PG_USER=postgres
HARNESS_PG_DB=harness

# Set to true on AKS to authenticate via Azure AD Workload Identity (no password).
# HARNESS_PG_USE_MANAGED_IDENTITY=true

# For local development without managed identity, you may set DATABASE_URL directly
# instead of the three vars above:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/harness

# ---------------------------------------------------------------------------
# Authentication (Azure AD / MSAL)
# ---------------------------------------------------------------------------
# Set to false to bypass Azure AD auth entirely (local dev without SSO).
HARNESS_AUTH_ENABLED=false

# Required when HARNESS_AUTH_ENABLED=true:
# HARNESS_AZURE_TENANT_ID=
# HARNESS_AZURE_CLIENT_ID=
# HARNESS_AZURE_CLIENT_SECRET=
# HARNESS_SESSION_SECRET=

# OAuth2 redirect URI registered in Azure AD (optional — overrides the default).
# HARNESS_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Session / security
# ---------------------------------------------------------------------------
# Set to false in local dev (TestClient speaks plain HTTP, not HTTPS).
HARNESS_SESSION_HTTPS_ONLY=false

# Comma-separated list of allowed Host header values. Defaults to * (any).
# Set to your public hostname in production to prevent Host-header injection.
# HARNESS_ALLOWED_HOSTS=eval-brew.example.com

# ---------------------------------------------------------------------------
# API / headless access
# ---------------------------------------------------------------------------
# Public base URL prepended to callback/webhook paths in API responses.
# Leave unset for relative paths (fine for single-host deployments).
# HARNESS_PUBLIC_URL=https://eval-brew.example.com

# Azure AD audience claim expected in Bearer tokens for the headless API.
# Defaults to HARNESS_AZURE_CLIENT_ID when unset.
# HARNESS_AZURE_API_AUDIENCE=

# ---------------------------------------------------------------------------
# File upload
# ---------------------------------------------------------------------------
# Maximum CSV upload size in bytes. Default: 10 MB (10485760).
# HARNESS_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Controls the harness.* logger level. One of: debug, info, warning, error.
LOG_LEVEL=debug
