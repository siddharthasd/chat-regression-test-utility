# Per-branch session pointer written by speckit slash commands;
# its value differs on every feature branch and would just churn.
.specify/feature.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Virtualenvs
.venv/
venv/
env/
ENV/

# Test / coverage / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local dev environment overrides — never commit real values
.env
.env.local

# Runtime / harness data
~/.harness/
flask_session/
data.db
*.log
*.tmp

# Sample / test CSV files — local only, never commit
*.csv

# Terraform — local config only, never commit to remote
*.tfvars
*.tf
