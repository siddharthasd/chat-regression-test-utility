# =============================================================================
# AI Regression Test Harness — environment configuration
#
# Copy this file to .env and fill in the values for your environment.
# Lines starting with # are comments and are ignored.
# Variables already set in the process environment take precedence over this
# file, so CI/container deployments that inject secrets directly are unaffected.
# =============================================================================


# -----------------------------------------------------------------------------
# Authentication mode
# Set to "false" for local development (no login page, all routes accessible).
# Set to "true" (or remove this line) for a shared server deployment with SSO.
# -----------------------------------------------------------------------------
HARNESS_AUTH_ENABLED=false


# -----------------------------------------------------------------------------
# Azure AD app registration
# Required when HARNESS_AUTH_ENABLED=true. Obtain these from the Azure portal
# (App registrations → your harness app → Overview / Certificates & secrets).
# -----------------------------------------------------------------------------
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Full callback URL registered in Azure AD.
# For local dev: http://localhost:5000/auth/callback
# For a shared server: https://your-server.accenture.com/auth/callback
AZURE_REDIRECT_URI=http://localhost:5000/auth/callback


# -----------------------------------------------------------------------------
# Flask session signing key
# Required when HARNESS_AUTH_ENABLED=true. Must be at least 32 characters.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep this secret — anyone who knows it can forge session cookies.
# -----------------------------------------------------------------------------
HARNESS_SECRET_KEY=replace-with-a-random-32-char-string


# -----------------------------------------------------------------------------
# Database
#
# DATABASE_URL (optional) — full SQLAlchemy connection URL.
# When set, it takes complete precedence and HARNESS_DB_PATH is ignored.
# Use this for PostgreSQL in cloud / container deployments.
#
#   PostgreSQL (Azure):
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
#
# When DATABASE_URL is NOT set, the app uses SQLite at HARNESS_DB_PATH.
# Default SQLite path (if both are unset): ~/.harness/data.db
#                                          (Windows: %USERPROFILE%\.harness\data.db)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://user:password@your-server.postgres.database.azure.com:5432/evalbrew?sslmode=require
# HARNESS_DB_PATH=C:\Users\you\.harness\data.db


# -----------------------------------------------------------------------------
# Public base URL (headless API — feature 020)
# Set this to the externally-accessible root URL of eval-brew so that
# results_url in API responses is a fully-qualified link that qual-brew
# users can click directly. No trailing slash.
# When unset, results_url is returned as a relative path.
# -----------------------------------------------------------------------------
# HARNESS_PUBLIC_URL=https://eval-brew.accenture.com


# -----------------------------------------------------------------------------
# Encryption key file
# Path to the master encryption key used to protect connector/evaluator
# credentials at rest.
# Default (if unset): %LOCALAPPDATA%\harness\master.key  (Windows)
#                     ~/.harness/master.key               (Linux/Mac)
# -----------------------------------------------------------------------------
# HARNESS_KEY_FILE=C:\Users\you\.harness\master.key


# -----------------------------------------------------------------------------
# File upload limit
# Maximum size in bytes for CSV uploads. Default: 52428800 (50 MiB).
# -----------------------------------------------------------------------------
# HARNESS_MAX_UPLOAD_BYTES=52428800


# -----------------------------------------------------------------------------
# Mock connector / evaluator behaviour (development and testing only)
# HARNESS_MOCK_MODE controls the mock service response type.
#   ok             — returns a well-formed conformant response (default)
#   nonconformant  — returns a malformed response to test error handling
#   status500      — returns an HTTP 500 to test connectivity error paths
#   slow           — simulates a slow response (5-second delay)
# HARNESS_MOCK_DIMENSIONS overrides the scoring dimensions the mock evaluator
# reports (comma-separated list, e.g. "accuracy,tone,completeness").
# -----------------------------------------------------------------------------
# HARNESS_MOCK_MODE=ok
# HARNESS_MOCK_DIMENSIONS=
